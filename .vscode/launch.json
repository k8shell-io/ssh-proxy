{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    // k8shell-db-postgresql-dev
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Go ssh-proxy",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "main.go",
            "env": {
                "SECRET_FILES": "/opt/shared/ssh-proxy/secrets",
                "PROVISIONER_SERVICE_HOST": "provisioner.k8shell-test",
                //"PROVISIONER_SERVICE_HOST": "10.42.1.97",
                //"IDENTITY_SERVICE_HOST": "identity.k8shell-test",
                "IDENTITY_SERVICE_HOST": "bruckins-identity.k8shell-io",
                "NATS_HOST": "nats.k8shell-test",
            },
            "cwd": "${workspaceFolder}",
            "args": [
                "--logtext",
                "--config",
                "config/config.yaml"
            ],
            "showLog": true
            //"stopOnEntry": true
        },
        {
            "name": "Connect to Delve server",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "port": 2345,
            "host": "127.0.0.1"
        }
    ]
}